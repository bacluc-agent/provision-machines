#!/usr/bin/env bash
set -Eeuo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export PATH="$HOME/.local/bin:$PATH"

status=0

check() {
  local name="$1"
  shift
  printf '==> %s\n' "$name"
  if "$@"; then
    printf 'PASS: %s\n' "$name"
  else
    printf 'FAIL: %s\n' "$name" >&2
    status=1
  fi
}

check 'dependencies (uv sync --frozen --all-extras)' uv sync --frozen --all-extras
check 'tests (pytest)' uv run pytest
check 'linting (ruff)' uv run ruff check .
check 'types (mypy)' uv run mypy .
# renovate: datasource=docker depName=ghcr.io/bacluc/prettier-image/prettier-image
export prettier_image_version=5.1.1
check 'formatting (prettier) + diff clean' sh -c 'docker run --rm -v "$PWD:/workdir" -w /workdir -u "$UID" ghcr.io/bacluc/prettier-image/prettier-image:$prettier_image_version && git diff --exit-code'

exit "$status"
