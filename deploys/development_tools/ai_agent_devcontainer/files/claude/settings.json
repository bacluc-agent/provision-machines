{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/completion-check"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Agent(*)",
      "Bash(*)",
      "Edit(*)",
      "ExitPlanMode(*)",
      "Glob(*)",
      "Grep(*)",
      "KillShell(*)",
      "LSP(*)",
      "Monitor(*)",
      "NotebookEdit(*)",
      "Read(*)",
      "WebFetch(*)",
      "Write(*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
